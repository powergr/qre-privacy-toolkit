{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "global-shortcut:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "C:\\Users\\**"
      ],
      "deny": [
        "$HOME/.ssh/**",
        "$HOME/.gnupg/**",
        "$HOME/.aws/**",
        "$HOME/AppData/Roaming/Microsoft/**",
        "$HOME/AppData/Local/Microsoft/**"
      ]
    }
  ]
}